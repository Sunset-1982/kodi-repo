<?xml version="1.0" encoding="UTF-8"?>
<window type="window" id="1198">
    <animation effect="fade" start="100" end="0" time="500">WindowClose</animation>
 
    <onload>AlarmClock(SplashTimeOut,noop,00:59,silent)</onload>
    <onload>RunScript(script.skinvariables,run_executebuiltin=special://skin/shortcuts/skinvariables-startup.json,use_rules=True)</onload>
 	<onunload condition="!String.IsEmpty(Skin.String(StartupPlaylist))">Stop</onunload>
 	
    <controls>
        <control type="group">
            <control type="image" description="Background">
                <include>Dimensions_Fullscreen</include>
                <texture colordiffuse="$VAR[StartupDiffuse]">$VAR[StartupFanart]</texture>
                <animation effect="fade" start="100" end="0" time="500" tween="quadratic">WindowClose</animation>
            </control>
            <control type="image">
                <centerleft>50%</centerleft>
                <centertop>50%</centertop>
                <width>900</width>
                <height>94</height>
                <aspectratio>keep</aspectratio>
                <texture>misc/logo-modern.png</texture>
	            <animation effect="fade" start="100" end="0" time="500">WindowClose</animation>
                <visible>String.IsEmpty(Skin.String(StartupPlaylist)) + String.IsEmpty(Skin.String(startupfanart.fallback))</visible>
            </control>
            <control type="videowindow">
                <visible>Player.HasVideo + !String.IsEmpty(Skin.String(StartupPlaylist))</visible>
                <include>Dimensions_Fullscreen</include>
            </control>            
        </control>
    </controls>
</window>